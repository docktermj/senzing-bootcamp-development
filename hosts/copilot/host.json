{
  "id": "copilot",
  "name": "GitHub Copilot",
  "package_format": "agent-plugin",
  "vars": {
    "product": "GitHub Copilot",
    "plugin_root": "${PLUGIN_ROOT}",
    "plugin_root_var": "PLUGIN_ROOT",
    "scripts_dir": "${PLUGIN_ROOT}/scripts",
    "docs_dir": "${PLUGIN_ROOT}/docs",
    "scripts_fallback": "<this-skill-dir>/../../scripts",
    "manifest_path": "plugin.json",
    "mcp_file": "mcp.json",
    "package_noun": "plugin",
    "invoke_start_bootcamp": "\"Start the bootcamp\"",
    "invoke_bootcamp_feedback": "\"Bootcamp feedback\"",
    "invoke_bootcamp_note": "\"Make a note\"",
    "invoke_graduate": "\"Graduate\"",
    "invoke_package_bootcamp": "\"Back up the bootcamp\"",
    "invoke_package_bootcamp_in_string": "'Back up the bootcamp'",
    "assistant": "GitHub Copilot",
    "scripts_relative": "../../scripts",
    "docs_relative": "../../docs",
    "model_capable": "a high-capability model",
    "skills_dir": "..",
    "session_control_examples": "",
    "dismissal_control_example": "",
    "shell_tool": "bash",
    "scripts_dir_powershell": "$env:PLUGIN_ROOT/scripts"
  },
  "layout": {
    "skills": "skills",
    "commands": null,
    "scripts": "scripts",
    "docs": "docs",
    "hooks/README.md": null,
    "hooks/fallbacks": null
  },
  "hooks": {
    "command": "python3 \"{{host.plugin_root}}/scripts/{script}\" {event}",
    "matchers": false,
    "entry": {
      "cwd": "."
    },
    "events": {
      "session_start": "sessionStart",
      "prompt_submit": "userPromptSubmitted",
      "pre_tool_use": "preToolUse",
      "post_tool_use": "postToolUse",
      "post_tool_use_failure": null,
      "stop": "agentStop",
      "pre_compact": "preCompact",
      "session_end": "sessionEnd"
    },
    "tools": {
      "write": "create",
      "edit": "edit",
      "shell": "bash"
    },
    "guaranteed": false,
    "note": "On GitHub Copilot the bootcamp's hooks run while the plugin is enabled, but what a hook may tell the assistant differs between the GitHub Copilot app and the Copilot CLI."
  },
  "options": {
    "hooks_file": "com.github.copilot/hooks/hooks.json",
    "adapter": {
      "result_dialect": "flat",
      "transcript_dialect": "event-data",
      "tool_categories": {
        "create": "write",
        "write": "write",
        "write_file": "write",
        "edit": "edit",
        "str_replace_editor": "edit",
        "apply_patch": "patch",
        "bash": "shell",
        "powershell": "shell"
      },
      "shell_dialects": {
        "powershell": "powershell"
      }
    }
  },
  "catalog": {
    "path": ".github/plugin/marketplace.json",
    "style": "agent-plugin",
    "name": "senzing-bootcamp"
  },
  "foreign_terms": [
    "Claude",
    "CLAUDE_",
    "Kiro",
    "Codex",
    "ChatGPT",
    "Gemini",
    "Antigravity"
  ],
  "site": {
    "order": 2,
    "name": "GitHub Copilot",
    "kind": "GitHub Copilot plugin",
    "plan": "Copilot Pro+",
    "plan_url": "https://github.com/features/copilot/plans",
    "note": "Runs in the GitHub Copilot app or Copilot CLI.",
    "lead": "From nothing installed to a running bootcamp, in the GitHub Copilot app or the Copilot CLI.",
    "description": "Install the Senzing Bootcamp plugin for GitHub Copilot and start the bootcamp, in the GitHub Copilot app or the Copilot CLI.",
    "commands_note": "GitHub Copilot runs each from the request itself; there is nothing to memorize."
  }
}
